---
// Layout de las paginas de proyecto en MDX. Misma cabecera blanca a ancho
// completo que la home, y despues la prosa en columna de lectura.
import Base from './Base.astro';

interface Props {
  frontmatter: {
    titulo: string;
    resumen: string;
    repo: string;
  };
}

const { titulo, resumen, repo } = Astro.props.frontmatter;
---

<Base titulo={`${titulo} — Marcos Guerrero`} descripcion={resumen}>
  <header class="cabecera">
    <div class="envoltorio">
      <nav class="migas" aria-label="Miga de pan">
        <a href="/">Marcos Guerrero</a>
        <span aria-hidden="true">/</span>
        <span class="apagado">Proyecto</span>
      </nav>
      <h1>{titulo}</h1>
      <p class="entrada lectura">{resumen}</p>
    </div>
  </header>

  <div class="envoltorio">
    <article class="prosa">
      <slot />
    </article>

    <footer class="pie">
      <p>
        <a href={repo}>Ver el código en GitHub →</a>
      </p>
      <p><a href="/">← Volver al inicio</a></p>
    </footer>
  </div>
</Base>

<style>
  .cabecera {
    background: var(--superficie);
    border-bottom: 1px solid var(--linea);
    padding-block: 40px 56px;
    margin-bottom: 56px;
  }

  @media (min-width: 768px) {
    .cabecera {
      padding-block: 56px 72px;
      margin-bottom: 72px;
    }
  }

  .migas {
    font-family: var(--mono);
    font-size: var(--t--1);
    letter-spacing: 0.06em;
    margin-bottom: 24px;
    display: flex;
    gap: 10px;
    align-items: center;
  }

  .migas a {
    text-decoration: none;
    color: var(--acento);
  }

  .migas a:hover {
    text-decoration: underline;
  }

  .migas span[aria-hidden] {
    color: var(--linea-fuerte);
  }

  .entrada {
    font-size: var(--t-1);
    line-height: 1.55;
    color: var(--apagado);
    margin-top: 20px;
  }

  .pie {
    margin-top: 72px;
    padding-block: 32px 72px;
    border-top: 1px solid var(--linea);
    font-family: var(--mono);
    font-size: var(--t--1);
    line-height: 2.2;
  }

  .pie a {
    text-decoration: none;
    border-bottom: 1px solid var(--acento);
    padding-bottom: 2px;
  }
</style>
