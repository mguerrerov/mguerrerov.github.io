---
// Diagrama de las etapas implementadas del pipeline. SVG escrito a mano, sin
// libreria. Vive en un componente .astro y no en el MDX porque alli el HTML se
// parsea como JSX y los atributos con guion (stroke-width) darian error.
import type { Idioma } from '../i18n/textos';

interface Props {
  idioma?: Idioma;
}

const { idioma = 'es' } = Astro.props;

const L = {
  es: {
    titulo: 'Etapas implementadas del pipeline',
    descripcion:
      'Flujo vertical de cuatro etapas a partir del origen: ficheros json.gz horarios de GH ' +
      'Archive; descarga concurrente con httpx; capa bronze en Parquet particionado por fecha ' +
      'con codec zstd; capa silver con tipado, proyeccion de columnas, deduplicado por id y ' +
      'clasificacion de actor en cinco clases; y tests de calidad, diecisiete pruebas incluida ' +
      'la conciliacion de recuentos entre bronze y silver por particion.',
    encabezado: 'pipeline batch · etapas implementadas',
    origenTitulo: 'origen: gh archive',
    origenSub: 'ficheros .json.gz horarios de eventos publicos',
    etapa1Titulo: '1 · descarga concurrente',
    etapa1Sub1: 'idempotente y reanudable · maximo 6 conexiones',
    etapa1Sub2: 'httpx · ingest/descargar.py',
    etapa2Titulo: '2 · bronze',
    etapa2Sub1: 'crudo sin transformar · parquet por fecha · zstd',
    etapa2Sub2: 'pyspark · spark_jobs/bronze.py',
    etapa3Titulo: '3 · silver',
    etapa3Sub1: 'tipado · proyeccion de columnas · dedup por id',
    etapa3Sub2: 'actor en 5 clases, no un booleano is_bot',
    etapa3Sub3: 'pyspark · spark_jobs/silver.py + bots.py',
    etapa4Titulo: '4 · tests de calidad',
    etapa4Sub1: '16 de coherencia + conciliacion bronze/silver',
    etapa4Sub2: 'pytest · calidad/tests_calidad.py',
    pie: 'backfill.py recorre las etapas 1 a 3 dia a dia, con freno de disco',
    figcaption:
      'Las etapas 1 a 4 son las que existen en el repositorio. El orquestador queda fuera del ' +
      'flujo porque no es una etapa: recorre las tres primeras, un día por vuelta.',
  },
  en: {
    titulo: 'Implemented stages of the pipeline',
    descripcion:
      'Vertical flow of four stages from the source: hourly json.gz files from GH ' +
      'Archive; concurrent download with httpx; bronze layer in Parquet partitioned by date ' +
      'with zstd codec; silver layer with typing, column projection, deduplication by id and ' +
      'actor classification into five classes; and quality tests, seventeen tests including ' +
      'the reconciliation of counts between bronze and silver by partition.',
    encabezado: 'batch pipeline · implemented stages',
    origenTitulo: 'source: gh archive',
    origenSub: 'hourly .json.gz files of public events',
    etapa1Titulo: '1 · concurrent download',
    etapa1Sub1: 'idempotent and resumable · max 6 connections',
    etapa1Sub2: 'httpx · ingest/descargar.py',
    etapa2Titulo: '2 · bronze',
    etapa2Sub1: 'raw, untransformed · parquet by date · zstd',
    etapa2Sub2: 'pyspark · spark_jobs/bronze.py',
    etapa3Titulo: '3 · silver',
    etapa3Sub1: 'typing · column projection · dedup by id',
    etapa3Sub2: 'actor in 5 classes, not a boolean is_bot',
    etapa3Sub3: 'pyspark · spark_jobs/silver.py + bots.py',
    etapa4Titulo: '4 · quality tests',
    etapa4Sub1: '16 consistency tests + bronze/silver reconciliation',
    etapa4Sub2: 'pytest · calidad/tests_calidad.py',
    pie: 'backfill.py walks stages 1 to 3 day by day, with a disk brake',
    figcaption:
      'Stages 1 to 4 are the ones that exist in the repository. The orchestrator is left out of ' +
      'the flow because it is not a stage: it walks the first three, one day per pass.',
  },
} as const;

const t = L[idioma];
---

<figure>
  <svg
    viewBox="0 0 580 524"
    role="img"
    aria-labelledby="tl-pipe ds-pipe"
    style="max-width:100%;height:auto"
    xmlns="http://www.w3.org/2000/svg"
  >
    <title id="tl-pipe">{t.titulo}</title>
    <desc id="ds-pipe">
      {t.descripcion}
    </desc>

    <defs>
      <marker
        id="pf"
        viewBox="0 0 10 10"
        refX="9"
        refY="5"
        markerWidth="7"
        markerHeight="7"
        markerUnits="userSpaceOnUse"
        orient="auto-start-reverse"
      >
        <path d="M0 0 L10 5 L0 10" fill="none" stroke="var(--apagado)" stroke-width="1.5"></path>
      </marker>
    </defs>

    <text x="30" y="24" font-family="'JetBrains Mono', ui-monospace, monospace" font-size="12" fill="var(--apagado)">{t.encabezado}</text>

    <rect x="30" y="44" width="520" height="54" fill="none" stroke="var(--apagado)" stroke-width="1" rx="4"></rect>
    <text x="48" y="66" font-family="'JetBrains Mono', ui-monospace, monospace" font-size="13" fill="var(--texto)">{t.origenTitulo}</text>
    <text x="48" y="84" font-family="'JetBrains Mono', ui-monospace, monospace" font-size="11" fill="var(--apagado)">{t.origenSub}</text>

    <line x1="290" y1="100" x2="290" y2="116" stroke="var(--apagado)" stroke-width="1.5" marker-end="url(#pf)"></line>

    <rect x="30" y="118" width="520" height="70" fill="none" stroke="var(--texto)" stroke-width="1" rx="4"></rect>
    <text x="48" y="140" font-family="'JetBrains Mono', ui-monospace, monospace" font-size="13" fill="var(--texto)">{t.etapa1Titulo}</text>
    <text x="48" y="158" font-family="'JetBrains Mono', ui-monospace, monospace" font-size="11" fill="var(--apagado)">{t.etapa1Sub1}</text>
    <text x="48" y="176" font-family="'JetBrains Mono', ui-monospace, monospace" font-size="11" fill="var(--apagado)">{t.etapa1Sub2}</text>

    <line x1="290" y1="190" x2="290" y2="206" stroke="var(--apagado)" stroke-width="1.5" marker-end="url(#pf)"></line>

    <rect x="30" y="208" width="520" height="70" fill="none" stroke="var(--texto)" stroke-width="1" rx="4"></rect>
    <text x="48" y="230" font-family="'JetBrains Mono', ui-monospace, monospace" font-size="13" fill="var(--texto)">{t.etapa2Titulo}</text>
    <text x="48" y="248" font-family="'JetBrains Mono', ui-monospace, monospace" font-size="11" fill="var(--apagado)">{t.etapa2Sub1}</text>
    <text x="48" y="266" font-family="'JetBrains Mono', ui-monospace, monospace" font-size="11" fill="var(--apagado)">{t.etapa2Sub2}</text>

    <line x1="290" y1="280" x2="290" y2="296" stroke="var(--apagado)" stroke-width="1.5" marker-end="url(#pf)"></line>

    <rect x="30" y="298" width="520" height="88" fill="none" stroke="var(--texto)" stroke-width="1" rx="4"></rect>
    <line x1="22" y1="302" x2="22" y2="382" stroke="var(--acento)" stroke-width="1.5"></line>
    <text x="48" y="320" font-family="'JetBrains Mono', ui-monospace, monospace" font-size="13" fill="var(--texto)">{t.etapa3Titulo}</text>
    <text x="48" y="338" font-family="'JetBrains Mono', ui-monospace, monospace" font-size="11" fill="var(--apagado)">{t.etapa3Sub1}</text>
    <text x="48" y="356" font-family="'JetBrains Mono', ui-monospace, monospace" font-size="11" fill="var(--apagado)">{t.etapa3Sub2}</text>
    <text x="48" y="374" font-family="'JetBrains Mono', ui-monospace, monospace" font-size="11" fill="var(--apagado)">{t.etapa3Sub3}</text>

    <line x1="290" y1="388" x2="290" y2="404" stroke="var(--apagado)" stroke-width="1.5" marker-end="url(#pf)"></line>

    <rect x="30" y="406" width="520" height="70" fill="none" stroke="var(--texto)" stroke-width="1" rx="4"></rect>
    <text x="48" y="428" font-family="'JetBrains Mono', ui-monospace, monospace" font-size="13" fill="var(--texto)">{t.etapa4Titulo}</text>
    <text x="48" y="446" font-family="'JetBrains Mono', ui-monospace, monospace" font-size="11" fill="var(--apagado)">{t.etapa4Sub1}</text>
    <text x="48" y="464" font-family="'JetBrains Mono', ui-monospace, monospace" font-size="11" fill="var(--apagado)">{t.etapa4Sub2}</text>

    <line x1="30" y1="496" x2="550" y2="496" stroke="var(--linea)" stroke-width="1"></line>
    <text x="30" y="512" font-family="'JetBrains Mono', ui-monospace, monospace" font-size="11" fill="var(--apagado)">{t.pie}</text>
  </svg>

  <figcaption>
    {t.figcaption}
  </figcaption>
</figure>
