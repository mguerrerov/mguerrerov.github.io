---
// Aviso de que un proyecto sigue en desarrollo. Sin caja ni fondo: solo una
// regla de acento a la izquierda y la etiqueta en monoespaciada.
import { textos, type Idioma } from '../i18n/textos';

interface Props {
  idioma?: Idioma;
  texto?: string;
}

const { idioma = 'es', texto } = Astro.props;

const t = textos(idioma);
// Por defecto se usa el aviso generico del diccionario, en el idioma de la
// pagina. Si una pagina necesita un texto distinto, el prop lo sobrescribe.
const cuerpo = texto ?? t.avisoGenerico;
---

<aside class="aviso" role="note">
  <p class="etiqueta">{t.enDesarrollo}</p>
  <p>{cuerpo}</p>
</aside>

<style>
  .aviso {
    border-left: 3px solid var(--acento);
    padding-left: 20px;
    margin-block: 2.4em;
  }

  .etiqueta {
    font-family: var(--mono);
    font-size: var(--t--1);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--acento);
    margin-bottom: 8px;
  }

  .aviso p:last-child {
    color: var(--apagado);
  }
</style>
