---
// Cifras tomadas del README.md del repositorio del proyecto.
import type { Idioma } from '../i18n/textos';

interface Props {
  idioma?: Idioma;
}

const { idioma = 'es' } = Astro.props;

const FILAS = {
  es: [
    ['dimensiones por vector', '384'],
    ['candidatos indexados', '18'],
    ['ofertas de prueba', '6'],
    ['pares evaluados', '108'],
    ['ventana del modelo', '128 tokens'],
    ['tests', '61, en 6 s'],
    ['coste de inferencia', '0 €'],
  ],
  en: [
    ['dimensions per vector', '384'],
    ['indexed candidates', '18'],
    ['test job postings', '6'],
    ['evaluated pairs', '108'],
    ['model window', '128 tokens'],
    ['tests', '61, in 6 s'],
    ['inference cost', '€0'],
  ],
} as const;
---

<dl class="metricas-lista">
  {
    FILAS[idioma].map(([etiqueta, valor]) => (
      <>
        <dt>{etiqueta}</dt>
        <dd>{valor}</dd>
      </>
    ))
  }
</dl>
