---
// Resultados de las seis combinaciones, ordenados por F1. Tabla real en vez de
// divs con roles ARIA: los lectores de pantalla anuncian filas y columnas sin
// depender de que los roles esten bien puestos.
//
// Los valores cambian de separador segun el idioma: en ingles la coma decimal
// se lee como separador de millares y cambiaria la cifra.
import type { Idioma } from '../i18n/textos';

interface Props {
  idioma?: Idioma;
}

const { idioma = 'es' } = Astro.props;

const FILAS = {
  es: [
    { modelo: 'RF · class_weight', f1: '0,8364', prec: '0,9857', rec: '0,7263', auc: '0,9141' },
    { modelo: 'RF · SMOTE', f1: '0,8324', prec: '0,9231', rec: '0,7579', auc: '0,9436' },
    { modelo: 'RF · submuestreo', f1: '0,1415', prec: '0,0771', rec: '0,8632', auc: '0,9737' },
    { modelo: 'LR · class_weight', f1: '0,1055', prec: '0,0561', rec: '0,8737', auc: '0,9658' },
    { modelo: 'LR · SMOTE', f1: '0,1002', prec: '0,0531', rec: '0,8737', auc: '0,9619' },
    { modelo: 'LR · submuestreo', f1: '0,0981', prec: '0,0520', rec: '0,8737', auc: '0,9559' },
  ],
  en: [
    { modelo: 'RF · class_weight', f1: '0.8364', prec: '0.9857', rec: '0.7263', auc: '0.9141' },
    { modelo: 'RF · SMOTE', f1: '0.8324', prec: '0.9231', rec: '0.7579', auc: '0.9436' },
    { modelo: 'RF · undersampling', f1: '0.1415', prec: '0.0771', rec: '0.8632', auc: '0.9737' },
    { modelo: 'LR · class_weight', f1: '0.1055', prec: '0.0561', rec: '0.8737', auc: '0.9658' },
    { modelo: 'LR · SMOTE', f1: '0.1002', prec: '0.0531', rec: '0.8737', auc: '0.9619' },
    { modelo: 'LR · undersampling', f1: '0.0981', prec: '0.0520', rec: '0.8737', auc: '0.9559' },
  ],
} as const;

const CABECERAS = {
  es: { modelo: 'modelo', f1: 'f1', prec: 'precisión', rec: 'recall', auc: 'auc' },
  en: { modelo: 'model', f1: 'f1', prec: 'precision', rec: 'recall', auc: 'auc' },
} as const;

const LEYENDA = {
  es: 'Resultados de las seis combinaciones de modelo y estrategia, ordenados por F1',
  en: 'Results of the six model and strategy combinations, ordered by F1',
} as const;

const filas = FILAS[idioma];
const cabeceras = CABECERAS[idioma];
---

<figure>
  <div class="marco">
    <table>
      <caption class="oculto">
        {LEYENDA[idioma]}
      </caption>
      <thead>
        <tr>
          <th scope="col">{cabeceras.modelo}</th>
          <th scope="col">{cabeceras.f1}</th>
          <th scope="col">{cabeceras.prec}</th>
          <th scope="col">{cabeceras.rec}</th>
          <th scope="col">{cabeceras.auc}</th>
        </tr>
      </thead>
      <tbody>
        {
          filas.map((f) => (
            <tr>
              <th scope="row">{f.modelo}</th>
              <td>{f.f1}</td>
              <td>{f.prec}</td>
              <td>{f.rec}</td>
              <td>{f.auc}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
  <figcaption>
    {idioma === 'es'
      ? 'Las tres últimas filas tienen mejor recall que las dos primeras y aun así no sirven: encuentran el fraude a cambio de señalar como fraude casi todo lo demás.'
      : 'The last three rows have better recall than the first two and still are not usable: they catch the fraud at the cost of flagging almost everything else as fraud too.'}
  </figcaption>
</figure>

<style>
  /* La tabla desborda en pantallas estrechas, asi que scrollea dentro de su
     marco y no arrastra el resto de la pagina. tabindex la hace alcanzable por
     teclado para poder desplazarla sin raton. */
  .marco {
    overflow-x: auto;
  }

  table {
    border-collapse: collapse;
    width: 100%;
    min-width: 32rem;
    font-family: var(--mono);
    font-size: var(--t--1);
  }

  caption {
    text-align: left;
  }

  th,
  td {
    padding: 10px 12px;
    text-align: right;
    font-variant-numeric: tabular-nums;
    font-weight: 400;
    border-bottom: 1px solid var(--linea);
  }

  th[scope='col'] {
    color: var(--apagado);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    border-bottom-color: var(--linea-fuerte);
  }

  th[scope='row'] {
    text-align: left;
    color: var(--texto);
  }

  tbody tr:first-child th[scope='row'],
  tbody tr:first-child td {
    color: var(--acento-oscuro);
  }

  .oculto {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>
