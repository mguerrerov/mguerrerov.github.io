---
// Resultados de las seis combinaciones, ordenados por F1. Tabla real en vez de
// divs con roles ARIA: los lectores de pantalla anuncian filas y columnas sin
// depender de que los roles esten bien puestos.
const filas = [
  { modelo: 'RF · class_weight', f1: '0,8364', prec: '0,9857', rec: '0,7263', auc: '0,9141' },
  { modelo: 'RF · SMOTE', f1: '0,8324', prec: '0,9231', rec: '0,7579', auc: '0,9436' },
  { modelo: 'RF · submuestreo', f1: '0,1415', prec: '0,0771', rec: '0,8632', auc: '0,9737' },
  { modelo: 'LR · class_weight', f1: '0,1055', prec: '0,0561', rec: '0,8737', auc: '0,9658' },
  { modelo: 'LR · SMOTE', f1: '0,1002', prec: '0,0531', rec: '0,8737', auc: '0,9619' },
  { modelo: 'LR · submuestreo', f1: '0,0981', prec: '0,0520', rec: '0,8737', auc: '0,9559' },
];
---

<figure>
  <div class="marco">
    <table>
      <caption class="oculto">
        Resultados de las seis combinaciones de modelo y estrategia, ordenados por F1
      </caption>
      <thead>
        <tr>
          <th scope="col">modelo</th>
          <th scope="col">f1</th>
          <th scope="col">precisión</th>
          <th scope="col">recall</th>
          <th scope="col">auc</th>
        </tr>
      </thead>
      <tbody>
        {
          filas.map((f) => (
            <tr>
              <th scope="row">{f.modelo}</th>
              <td>{f.f1}</td>
              <td>{f.prec}</td>
              <td>{f.rec}</td>
              <td>{f.auc}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
  <figcaption>
    Las tres últimas filas tienen mejor recall que las dos primeras y aun así no sirven:
    encuentran el fraude a cambio de señalar como fraude casi todo lo demás.
  </figcaption>
</figure>

<style>
  /* La tabla desborda en pantallas estrechas, asi que scrollea dentro de su
     marco y no arrastra el resto de la pagina. tabindex la hace alcanzable por
     teclado para poder desplazarla sin raton. */
  .marco {
    overflow-x: auto;
  }

  table {
    border-collapse: collapse;
    width: 100%;
    min-width: 32rem;
    font-family: var(--mono);
    font-size: var(--t--1);
  }

  caption {
    text-align: left;
  }

  th,
  td {
    padding: 10px 12px;
    text-align: right;
    font-variant-numeric: tabular-nums;
    font-weight: 400;
    border-bottom: 1px solid var(--linea);
  }

  th[scope='col'] {
    color: var(--apagado);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    border-bottom-color: var(--linea-fuerte);
  }

  th[scope='row'] {
    text-align: left;
    color: var(--texto);
  }

  tbody tr:first-child th[scope='row'],
  tbody tr:first-child td {
    color: var(--acento-oscuro);
  }

  .oculto {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>
