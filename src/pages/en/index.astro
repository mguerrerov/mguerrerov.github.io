---
// Home inglesa. Misma estructura que la española: las cifras son las mismas
// mediciones, solo cambia el separador decimal y de millares.
import Base from '../../layouts/Base.astro';
import MiniFlujo from '../../components/MiniFlujo.astro';
import AvisoDesarrollo from '../../components/AvisoDesarrollo.astro';
import Idioma from '../../components/Idioma.astro';
import { textos } from '../../i18n/textos';

const cifras = [
  { valor: '1,311 M', etiqueta: 'events processed' },
  { valor: '12.5', etiqueta: 'months of history' },
  { valor: '4', etiqueta: 'published projects' },
  { valor: '0 €', etiqueta: 'infrastructure cost' },
];
const t = textos('en');
---

<Base
  titulo="Marcos Guerrero"
  descripcion="Data engineering and applied intelligence. Python, Spark and machine learning."
>
  <header class="cabecera">
    <div class="envoltorio">
      <Idioma />
      {/* BORRADOR: las DOS lineas de presentacion que siguen -el rotulo de
           oficio y el parrafo de entrada- son traduccion pendiente de
           reescritura por el autor. La voz de la presentacion es suya; esto es
           solo un punto de partida. Abarca <p class="oficio"> y
           <p class="entrada">, no solo el parrafo. */}
      <p class="oficio">Data and artificial intelligence</p>
      <h1>Marcos Guerrero</h1>
      {/* BORRADOR (2 de 2): sigue la segunda linea de presentacion, tambien
           pendiente de reescritura por el autor. */}
      <p class="entrada lectura">
        I prepare and process data so it answers questions: from the raw dump to
        the trained model and the report someone uses to decide.
      </p>
      <p class="enlaces">
        <a href="#proyectos">See projects</a>
        <span class="sep" aria-hidden="true">·</span>
        <a href="#contacto">Contact</a>
        <span class="sep" aria-hidden="true">·</span>
        <a href={t.ficheroCv} download>{t.descargarCv}</a>
      </p>

      <dl class="metricas cifras-cabecera">
        {
          cifras.map((c) => (
            <div>
              <dt>{c.etiqueta}</dt>
              <dd>{c.valor}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </header>

  <div class="envoltorio">
    <section id="proyectos" class="seccion" aria-labelledby="t-proyectos">
      <h2 class="rotulo" id="t-proyectos">01 — Projects</h2>

      <article class="tarjeta proyecto">
        <p class="destacado">Main project</p>
        <h3 class="titulo-grande">Pipeline over GH Archive</h3>

        <AvisoDesarrollo
          idioma="en"
          texto="Still under construction: the figures reflect the current state and may change."
        />

        <p class="lectura">
          Twelve and a half months of public GitHub activity, downloaded hour by
          hour and turned into queryable Parquet. It measures how many pull
          requests are already opened by an automated agent and how long each one
          waits before review.
        </p>

        <MiniFlujo
          titulo="Stages: download, bronze, silver and quality"
          etapas={['gh archive', 'download', 'bronze', 'silver', 'quality']}
          destacada={3}
        />

        <dl class="metricas-lista">
          <dt>events</dt>
          <dd>1,311,676,396</dd>

          <dt>period</dt>
          <dd>12.5 months</dd>

          <dt>parquet on disk</dt>
          <dd>149.4 GiB</dd>

          <dt>compression over the source</dt>
          <dd>0.54×</dd>

          <dt>duplicates</dt>
          <dd>0.0009%</dd>
        </dl>

        <p class="lectura">
          It runs end to end on a desktop machine, no paid cloud. The expensive
          part was not processing it but making it fit: the disk filled up twice
          before the deduplication step was reordered.
        </p>

        <ul class="etiquetas">
          <li>pyspark</li>
          <li>parquet</li>
          <li>zstd</li>
          <li>httpx</li>
          <li>pytest</li>
          <li>github actions</li>
        </ul>

        <p class="mas"><a href="/en/proyectos/gh-archive/">{t.leerMas}</a></p>
      </article>

      <article class="tarjeta proyecto">
        <h3 class="titulo-grande">Real-time Wikipedia pipeline</h3>

        <AvisoDesarrollo
          idioma="en"
          texto="The local layers are finished and measured; the AWS equivalent is validated but not applied."
        />

        <p class="lectura">
          Wikimedia publishes every change on every wiki as it happens. The
          pipeline collects them, sorts them into three layers and answers, in
          one-minute windows, which pages are being edited by more than one
          person at once and how much of the activity is human.
        </p>

        <MiniFlujo
          titulo="Stages: source, queue, bronze, silver, gold and AWS"
          etapas={['wikimedia sse', 'queue', 'bronze', 'silver', 'gold', 'aws']}
          destacada={5}
        />

        <dl class="metricas-lista">
          <dt>source rate</dt>
          <dd>37.4 ev/s sustained</dd>

          <dt>p50 latency</dt>
          <dd>15.59 s</dd>

          <dt>duplicates in silver</dt>
          <dd>0 out of 71,484 rows</dd>

          <dt>gaps in bronze</dt>
          <dd>0</dd>

          <dt>infrastructure cost</dt>
          <dd>0 €</dd>
        </dl>

        <p class="lectura">
          The same code runs on a laptop and on AWS without forking. The hard
          part was not removing the conditional separating both environments, but
          finding out that the difference had crept in anyway, column by column,
          underneath the abstraction meant to prevent it.
        </p>

        <ul class="etiquetas">
          <li>spark streaming</li>
          <li>kafka</li>
          <li>kinesis</li>
          <li>iceberg</li>
          <li>terraform</li>
          <li>docker</li>
        </ul>

        <p class="mas">
          <a href="/en/proyectos/wikipedia-tiempo-real/">{t.leerMas}</a>
        </p>
      </article>

      <div class="rejilla">
        <article class="tarjeta proyecto">
          <h3>Candidate recommender</h3>
          <p>
            It ranks CVs against a job offer by semantic closeness instead of
            keywords, then corrects the ranking by discounting the hard
            requirements an embedding cannot read.
          </p>

          <dl class="metricas-lista">
            <dt>dimensions</dt>
            <dd>384</dd>

            <dt>tests</dt>
            <dd>61, in 6 s</dd>
          </dl>

          <ul class="etiquetas">
            <li>embeddings</li>
            <li>numpy</li>
            <li>mysql</li>
            <li>fastapi</li>
            <li>streamlit</li>
          </ul>

          <p class="mas">
            <a href="/en/proyectos/recomendador-candidatos/">{t.leerMas}</a>
          </p>
        </article>

        <article class="tarjeta proyecto">
          <h3>Credit card fraud detection</h3>
          <p>
            284,807 transactions with 0.17% fraud. It compares three ways of
            handling that imbalance against two models, and the winner is the one
            that leaves the data untouched.
          </p>

          <dl class="metricas-lista">
            <dt>best F1</dt>
            <dd>0.8364</dd>

            <dt>precision</dt>
            <dd>98.57%</dd>
          </dl>

          <ul class="etiquetas">
            <li>scikit-learn</li>
            <li>smote</li>
            <li>random forest</li>
            <li>pandas</li>
          </ul>

          <p class="mas"><a href="/en/proyectos/deteccion-fraude/">{t.leerMas}</a></p>
        </article>
      </div>
    </section>

    <section id="stack" class="seccion" aria-labelledby="t-stack">
      <h2 class="rotulo" id="t-stack">02 — Stack</h2>
      <div class="tarjeta">
        <dl class="agrupado">
          <dt>data</dt>
          <dd>Python, Pandas, NumPy, Spark, Power BI</dd>

          <dt>models</dt>
          <dd>Scikit-Learn, PyTorch</dd>

          <dt>databases</dt>
          <dd>PostgreSQL, MySQL</dd>

          <dt>languages</dt>
          <dd>Python, JavaScript, PHP, Java</dd>

          <dt>systems</dt>
          <dd>Linux, Windows, AWS</dd>

          <dt>certification</dt>
          <dd>AWS Certified Cloud Practitioner</dd>

          <dt>spoken languages</dt>
          <dd>Native Spanish, English B2–C1</dd>
        </dl>
      </div>
    </section>

    <section id="contacto" class="seccion" aria-labelledby="t-contacto">
      <h2 class="rotulo" id="t-contacto">03 — Contact</h2>
      <div class="tarjeta">
        <dl class="agrupado">
          <dt>email</dt>
          <dd><a href="mailto:marcosguerrerov27@gmail.com">marcosguerrerov27@gmail.com</a></dd>

          <dt>github</dt>
          <dd><a href="https://github.com/mguerrerov">github.com/mguerrerov</a></dd>

          <dt>linkedin</dt>
          <dd>
            <a href="https://www.linkedin.com/in/marcos-guerrero-villamor-318683299/"
              >marcos-guerrero-villamor</a
            >
          </dd>
        </dl>
      </div>
    </section>
  </div>
</Base>

<style>
  /* Cabecera: franja blanca a ancho completo, separada del cuerpo por una regla.
     Es lo que da el arranque corporativo sin recurrir a un hero. */
  .cabecera {
    background: var(--superficie);
    border-bottom: 1px solid var(--linea);
    padding-block: 64px 0;
    margin-bottom: var(--seccion);
  }

  @media (min-width: 768px) {
    .cabecera {
      padding-top: 96px;
    }
  }

  .oficio {
    font-family: var(--mono);
    font-size: var(--t--1);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--acento);
    margin-bottom: 20px;
  }

  .entrada {
    font-size: var(--t-1);
    line-height: 1.55;
    color: var(--apagado);
    margin-top: 24px;
  }

  .enlaces {
    font-family: var(--mono);
    font-size: var(--t--1);
    margin-top: 28px;
  }

  .sep {
    color: var(--linea-fuerte);
    margin-inline: 10px;
  }

  .cifras-cabecera {
    margin-top: 56px;
    border-bottom: 0;
    padding-bottom: 40px;
  }

  /* En el HTML la etiqueta va primero, que es el orden correcto de una lista de
     descripcion. Visualmente la cifra manda, asi que se invierte con flex. */
  .cifras-cabecera div {
    display: flex;
    flex-direction: column-reverse;
  }

  .cifras-cabecera dt {
    margin-top: 4px;
  }

  .cifras-cabecera dd {
    margin-top: 0;
    font-size: var(--t-3);
  }

  /* El proyecto principal se ve mas grande que los otros dos, pero sigue siendo
     un h3: el nivel es semantica y el tamano es presentacion. */
  .titulo-grande {
    font-family: var(--serif);
    font-weight: 400;
    font-size: var(--t-3);
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  /* Proyectos */
  .proyecto > * + * {
    margin-top: 1.3em;
  }

  .proyecto h2,
  .proyecto h3 {
    margin-top: 0.3em;
  }

  .destacado {
    font-family: var(--mono);
    font-size: var(--t--1);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--acento);
  }

  .rejilla {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
    margin-top: 24px;
  }

  @media (min-width: 880px) {
    .rejilla {
      grid-template-columns: 1fr 1fr;
    }
  }

  .mas a {
    font-family: var(--mono);
    font-size: var(--t--1);
    text-decoration: none;
    border-bottom: 1px solid var(--acento);
    padding-bottom: 2px;
  }

  /* La ultima seccion necesita aire por debajo, ya que no hay pie. */
  .seccion:last-of-type {
    padding-bottom: var(--seccion);
  }
</style>
